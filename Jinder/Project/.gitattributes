# Normalize line endings so the repo behaves the same on Windows, Linux, and CI.
* text=auto eol=lf

*.py   text eol=lf
*.js   text eol=lf
*.html text eol=lf
*.css  text eol=lf
*.json text eol=lf
*.yaml text eol=lf
*.yml  text eol=lf
*.md   text eol=lf
*.toml text eol=lf
*.txt  text eol=lf

# Binary assets.
*.png  binary
*.jpg  binary
*.pdf  binary
*.faiss binary
