# Copy to services/.env and fill in. services/.env is gitignored.

# --- AWS ---
# S3 bucket holding the raw job/grant JSON dumps written by the ingestion Lambda.
S3_BUCKET_NAME=
# Key prefix inside that bucket. Defaults to "raw_data/" if unset.
S3_KEY_PREFIX=raw_data/
# DynamoDB table holding user accounts. Defaults to "JinderUsers" if unset.
JINDER_USERS_TABLE=JinderUsers
# Region for both DynamoDB and S3.
AWS_REGION=us-east-1

# --- Job sources ---
# RapidAPI key for the JSearch endpoint: https://rapidapi.com/letscrape-6bRBa3QguO5/api/jsearch
RAPIDAPI_KEY=
# USAJOBS API key: https://developer.usajobs.gov/apirequest/
USAJOBS_API_KEY=
# The email you registered with USAJOBS. Sent as the User-Agent header, which
# their API requires.
USAJOBS_EMAIL=
# Grants.gov search needs no key.

# --- Ingestion Lambda ---
# Base URL of the running FastAPI service. The Lambda POSTs to <FASTAPI_URL>/reload
# after uploading new data. Leave empty to skip that callback.
FASTAPI_URL=
